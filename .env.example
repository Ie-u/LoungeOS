NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only. Never prefix this variable with NEXT_PUBLIC_. Required for staff invites and recovery emails.
SUPABASE_SERVICE_ROLE_KEY=replace_with_a_server_side_secret_key

# Safaricom Daraja, server-only. Keep sandbox until production approval/keys exist.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline or CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Existing customer-facing destination; configure the relevant value(s).
MPESA_PAYBILL_NUMBER=
MPESA_TILL_NUMBER=
# Generate at least 32 random bytes (hex) and register the URLs below in Daraja.
MPESA_C2B_CALLBACK_TOKEN=
